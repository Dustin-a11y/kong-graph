# OpenRouter credentials for LongMemEval native pipeline.
# Copy this file to benchd-openrouter.env and fill in your API key.
# NEVER commit benchd-openrouter.env — it's in .gitignore.

# OpenRouter API base URL (default shown)
BENCHD_API_BASE=https://openrouter.ai/api/v1

# Your OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
